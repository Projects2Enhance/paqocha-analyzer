[{"text":"pauli","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-na","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."}]},{"word":"Arpasi","morphemes":[{"text":"arpa","type":"root","gloss":"s.","meaning":"Ofrenda, inmolación, o blación"},{"text":"-si","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'dicen que'. Indica que el hablante no ha sido testigo de la acción o no está muy seguro de lo que dice. Se usa cuando hay duda.  Cuando la palabra termina en vocal se usa la \"s\" y cuando termina en consonante se usa la \"si\" . El hablante declara o comenta sobre algo que escapa  de su conocimiento personal y directo (inconsciente)."}]},{"word":"nisqa.","morphemes":[{"text":"ni","type":"root","gloss":"v.","meaning":"Decir, mencionar, expresar, manifestar. "},{"text":"-sqa","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Participio pasivo ('escrito') o pasado narrativo. indica hecho consumado, se utiliza en narraciones."}]},{"word":"Pay","morphemes":[{"text":"pay","type":"root","gloss":"pron.","meaning":"Pronombre 3SG (él/ella)."}]},{"word":"ñawpaq","morphemes":[{"text":"ñawpaq","type":"root","gloss":"adj. y s.","meaning":". "}]},{"word":"ehh","morphemes":[{"text":"ehh","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"warmi","morphemes":[{"text":"warmi","type":"root","gloss":"s.","meaning":"Mujer, fémina o femenina. "}]},{"word":"purirqan","morphemes":[{"text":"puri","type":"root","gloss":"s.","meaning":"Locomoción, tracción o desplazamiento"},{"text":"-rqan","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -rqan"}]},{"word":"Congreso","morphemes":[{"text":"congreso","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"de","morphemes":[{"text":"de","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"la","morphemes":[{"text":"la","type":"root","gloss":"desconocido","meaning"