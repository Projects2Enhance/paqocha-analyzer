ATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"uywawan","morphemes":[{"text":"uywa","type":"root","gloss":"s.","meaning":"Animal, nombre genérico con que se conoce a los equinos"},{"text":"-wan","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Conjunción que enlaza palabras o frases ('y', 'con'). Es un caso cogitativo, porque indica compromiso, compañía o instrumento."}]},{"word":"wiñarqanku,","morphemes":[{"text":"wiña","type":"root","gloss":"s.","meaning":"Crecimiento, desarrollo"},{"text":"-rqa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Temporizador de pasado simple lejano y experimentado"},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"chaytan","morphemes":[{"text":"chay","type":"root","gloss":"pron.","meaning":"Ése, ésa, éso."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"nuqa","morphemes":[{"text":"nuqa","type":"root","gloss":"pron.","meaning":"Pronombre 1SG (yo). Variante regional Collao/Puno."}]},{"word":"paykunamantan","morphemes":[{"text":"pay","type":"root","gloss":"pron.","meaning":"Pronombre 3SG (él/ella)."},{"text":"-na","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."},{"text":"-manta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica procedencia (‘de’, ‘desde’) o el material de algo."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"yachaqarqani.","morphemes":[{"text":"yachaqarqani","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"Paykunaqa","morphemes":[{"text":"pay","type":"root","gloss":"pron.","meaning":"Pronombre 3SG (él/ella)."},{"text":"-na","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"nuqa","morphemes":[{"text":"nuqa","type":"root","gloss":"pron.","meaning":"Pronombre 1SG (yo). Variante regional Collao/Puno."}]},{"word":"irqi","morphemes":[{"text":"irqi","type":"root","gloss":"s.","meaning":"Niño infante. "}]},{"word":"kashallaspa","morphemes":[{"text":"kasha","type":"root","gloss":"v.","meaning":"Estar. "},{"text":"-lla","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'solamente’ o ‘únicamente’.Transmite afecto o es atenuador en las órdenes."},{"text":"-spa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Indica que la acción dependiente es anterior a la del verbo principal. Puede ser un gerundio."}]},{"word":"yanapawaranku,","morphemes":[{"text":"yanapa","type":"root","gloss":"s.","meaning":"Ayuda, apoyo, asistencia, auxilio, colaboración"},{"text":"-wa","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -wa"},{"text":"-ran","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -ran"},{"text":"-ku","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica un verbo reflexivo. Funciona como los pronombres enclíticos: me, te, se, nos. Se convierte en ‘KA’, cuando precede al sufijo -MU. Con verbos transitivos. indica una acción refleja, o sea la acción recae  sobre el propio sujeto. En otros casos  indica beneficio o provecho personal. tambien tiene valor impersonal."}]},{"word":"qullqitachus","morphemes":[{"text":"qullqi","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."},{"text":"-chu","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Interrogativo que exige respuesta afirmativa o negativa. Solo para preguntas cerradas."},{"text":"-s","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'dicen que'. Indica que el hablante no ha sido testigo de la acción o no está muy seguro de lo que dice. Se usa cuando hay duda.  Cuando la palabra termina en vocal se usa la \"s\" y cuando termina en consonante se usa la \"si\" . El hablante declara o comenta sobre algo que escapa  de su conocimiento personal y directo (inconsciente)."}]},{"word":"quwaranku","morphemes":[{"text":"qu","type":"root","gloss":"v.","meaning":"Dar, conceder, entregar, asignar, donar. . . "},{"text":"-wa","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -wa"},{"text":"-ran","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -ran"},{"text":"-ku","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica un verbo reflexivo. Funciona como los pronombres enclíticos: me, te, se, nos. Se convierte en ‘KA’, cuando precede al sufijo -MU. Con verbos transitivos. indica una acción refleja, o sea la acción recae  sobre el propio sujeto. En otros casos  indica beneficio o provecho personal. tambien tiene valor impersonal."}]},{"word":"ima.","morphemes":[{"text":"ima","type":"root","gloss":"pron. / adv.","meaning":"¿Qué?, qué, algo."}]},{"word":"Wasinkuta","morphemes":[{"text":"wasi","type":"root","gloss":"s.","meaning":"Casa, aposento, edificio, hogar, morada"},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"chayaq","morphemes":[{"text":"chayaq","type":"root","gloss":"adj. y s.","meaning":"Que llega a un sitio determinado"}]},{"word":"kani","morphemes":[{"text":"kani","type":"root","gloss":"s.","meaning":"Mordedura"}]},{"word":"hinaqa","morphemes":[{"text":"hina","type":"root","gloss":"v.","meaning":"Hacer u obrar de esta manera, de este modo; hacer así (ilustrando con mímica). "},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"mikhunataqa","morphemes":[{"text":"mikhuna","type":"root","gloss":"s.","meaning":"Alimento, comida, comestible"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"qullawaqkupuni.","morphemes":[{"text":"qulla","type":"root","gloss":"s.","meaning":"Nombre del habitante de la región altiplánica del Qollasuyo. . "},{"text":"-wa","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -wa"},{"text":"-q","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Su marca es “-q” cuando termina en vocal y \"-paq\" cuando termina en consonante, que es igual a la preposición “de”."},{"text":"-ku","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica un verbo reflexivo. Funciona como los pronombres enclíticos: me, te, se, nos. Se convierte en ‘KA’, cuando precede al sufijo -MU. Con verbos transitivos. indica una acción refleja, o sea la acción recae  sobre el propio sujeto. En otros casos  indica beneficio o provecho personal. tambien tiene valor impersonal."},{"text":"-puni","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Indica afirmación o negación rotunda; certidumbre plena ('definitivamente'). Expresa seguridad."}]}]}}