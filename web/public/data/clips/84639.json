xt":"wiñar","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-pa","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica que la acción se realiza más de una vez."},{"text":"-ri","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Expresa el inicio del proceso verbal o la realización parcial de aquél. Indica también matiz de cortesía sobre pedidos o mandatos. Indica el inicio de una acción."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"sumaq","morphemes":[{"text":"sumaq","type":"root","gloss":"adj.","meaning":"Bello, bueno, agradable, exquisito, simpático. "}]},{"word":"uywakunapis","morphemes":[{"text":"uywa","type":"root","gloss":"s.","meaning":"Animal, nombre genérico con que se conoce a los equinos"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."},{"text":"-pis","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Aditivo. Se traduce como ‘también’ o ‘incluso’. Coordina oraciones."}]},{"word":"kashan.","morphemes":[{"text":"kasha","type":"root","gloss":"v.","meaning":"Estar. "},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]}]}}