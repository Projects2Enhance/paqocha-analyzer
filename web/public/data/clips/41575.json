ype":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo que se agrega cuando la palabra termina en vocal, se sgrega antes del sufijo posesivo."},{"text":"-raq","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Indica anterioridad o la continuidad de un estado de cosas."}]},{"word":"punamanta","morphemes":[{"text":"puna","type":"root","gloss":"s.","meaning":"Piso ecológico alto andino que se encuentra desde los 3,700 a 4,990 m.s.n.m. puna"},{"text":"-manta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica procedencia (‘de’, ‘desde’) o el material de algo."}]},{"word":"runawan","morphemes":[{"text":"runa","type":"root","gloss":"adj.","meaning":"V. RUNALLAÑA"},{"text":"-wan","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Conjunción que enlaza palabras o frases ('y', 'con'). Es un caso cogitativo, porque indica compromiso, compañía o instrumento."}]},{"word":"sumaqta","morphemes":[{"text":"sumaq","type":"root","gloss":"adj.","meaning":"Bello, bueno, agradable, exquisito, simpático. . sumaq"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"qichwapi","morphemes":[{"text":"qichwa","type":"root","gloss":"s. / adj.","meaning":"Quechua, lengua quechua."},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."}]},{"word":"parlaykunku.","morphemes":[{"text":"parla","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-yku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona plural excluyente."},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"Ñawpaqsi","morphemes":[{"text":"ñawpaq","type":"root","gloss":"adj.","meaning":"y s. . "},{"text":"-si","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'dicen que'. Indica que el hablante no