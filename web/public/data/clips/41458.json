root","gloss":"adv.","meaning":"¿Dónde?, dónde."},{"text":"-t'unkunata","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -t'unkunata"}]},{"word":"ñawinchayta","morphemes":[{"text":"ñawinchay","type":"root","gloss":"v.","meaning":"Colocar los ojos en el trabajo de imaginería o en la pintura"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"munaq","morphemes":[{"text":"munaq","type":"root","gloss":"adj.","meaning":"y s. Amante, pretendiente, que quiere"}]},{"word":"kani","morphemes":[{"text":"kani","type":"root","gloss":"s.","meaning":"Mordedura"}]},{"word":"imaraykuchus","morphemes":[{"text":"ima","type":"root","gloss":"pron. / adv.","meaning":"¿Qué?, qué, algo."},{"text":"-yku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona plural excluyente."},{"text":"-chu","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Interrogativo que exige respuesta afirmativa o negativa. Solo para preguntas cerradas."},{"text":"-s","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'dicen que'. Indica que el hablante no ha sido testigo de la acción o no está muy seguro de lo que dice. Se usa cuando hay duda.  Cuando la palabra termina en vocal se usa la \"s\" y cuando termina en consonante se usa la \"si\" . El hablante declara o comenta sobre algo que escapa  de su conocimiento personal y directo (inconsciente)."}]},{"word":"wasillapi","morphemes":[{"text":"wasi","type":"root","gloss":"s.","meaning":"(Casa de las escogidas). En el Inkario, casa donde habitaban las escogidas o Vírgenes del Sol, hoy mo nasterio de Santa Catalina. Se ubicaba en la parte oriental, in mediata a Inti k'ikllu, actual calle Loreto, en el Qosqo"},{"text":"-lla","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'solamente’ o ‘únicamente’.Transmite afecto o es atenuador en las órdenes."},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."}]},{"word":"pukllaq","morphemes":[{"text":"pukllaq","type":"root","gloss":"adj.","meaning":"y s. Jugador, deportista, apostador. . . "}]},{"word":"kani,","morphemes":[{"text":"kani","type":"root","gloss":"s.","meaning":"Mordedura"}]},{"word":"wiñariqtiytaq","morphemes":[{"text":"wiñariqti","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-y","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo de primera persona singular."},{"text":"-taq","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"También marca la pregunta abierta que requiere alguna información adicional como respuesta."}]},{"word":"Ananea","morphemes":[{"text":"ananea","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"llaqtata","morphemes":[{"text":"llaqta","type":"root","gloss":"s.","meaning":"Ciudad metro- poli, gran ciudad"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"llam'kaq","morphemes":[{"text":"llam'ka","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-q","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Su marca es “-q” cuando termina en vocal y \"-paq\" cuando termina en consonante, que es igual a la preposición “de”."}]},{"word":"purirkani","morphemes":[{"text":"purirka","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-ni","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo que se agrega cuando la palabra termina en vocal, se sgrega antes del sufijo posesivo."}]},{"word":"wawakuna","morphemes":[{"text":"wawa","type":"root","gloss":"adj.","meaning":"y s. fam. Hijo de ramera o prostituta"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."}]},{"word":"uywapakuq.","morphemes":[{"text":"uywapakuq","type":"root","gloss":"adj.","meaning":"y s. Persona que por favor o por paga se encarga de criar o cuidar hijos ajenos"}]},{"word":"Sipasña","morphemes":[{"text":"sipasña","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"kaspataq","morphemes":[{"text":"ka","type":"root","gloss":"s.","meaning":"Acto de dar o entregar algo a otra persona. . "},{"text":"-spa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Indica que la acción dependiente es anterior a la del verbo principal. Puede ser un gerundio."},{"text":"-taq","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"También marca la pregunta abierta que requiere alguna información adicional como respuesta."}]},{"word":"Arequipa,","morphemes":[{"text":"arequi","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-pa","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica que la acción se realiza más de una vez."}]},{"word":"Qusqu","morphemes":[{"text":"qusqu","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"llaqtakunapi","morphemes":[{"text":"llaqta","type":"root","gloss":"s.","meaning":"Ciudad metro- poli, gran ciudad"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."}]},{"word":"tiyaq","morphemes":[{"text":"tiyaq","type":"root","gloss":"adj.","meaning":"y s. Que permanece sentado"}]},{"word":"kani.","morphemes":[{"text":"kani","type":"root","gloss":"s.","meaning":"Mordedura"}]}]}}