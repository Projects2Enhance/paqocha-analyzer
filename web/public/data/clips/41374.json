,","morphemes":[{"text":"para","type":"root","gloss":"s.","meaning":"Lluvia, precipitación plu vial, aguacero. VARIEDADES. iphu para, llovizna; siphsi para, llovizna menuda; ch'allchaq para, chaparrón, lluvia torrencial; chikchipara, lluvia con granizo. . . "},{"text":"-puni","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Indica afirmación o negación rotunda; certidumbre plena ('definitivamente'). Expresa seguridad."}]},{"word":"unupuni","morphemes":[{"text":"unu","type":"root","gloss":"s.","meaning":"Agua; líquido incoloro, inodoro e insípido compuesto por dos volúmenes de hidrógeno y uno de oxígeno. . "},{"text":"-puni","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Indica afirmación o negación rotunda; certidumbre plena ('definitivamente'). Expresa seguridad."}]},{"word":"ima","morphemes":[{"text":"ima","type":"root","gloss":"pron. / adv.","meaning":"¿Qué?, qué, algo."}]},{"word":"muhutapas","morphemes":[{"text":"muhu","type":"root","gloss":"s.","meaning":"Semilla, simiente, semen. . "},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."},{"text":"-pas","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Aditivo. Se traduce como ‘también’ o ‘incluso’. Coordina oraciones."}]},{"word":"phuturichin.","morphemes":[{"text":"phutu","type":"root","gloss":"s.","meaning":"Yelma, brote o renuevo de las plantas"},{"text":"-ri","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Expresa el inicio del proceso verbal o la realización parcial de aquél. Indica también matiz de cortesía sobre pedidos o mandatos. Indica el inicio de una acción."},{"text":"-chi","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica que el sujeto motiva una acción que es ejecutada por otro. Corresponde al verbo ‘hacer’."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"Chaysi","morphemes":[{"text":"chay","type":"root","gloss":"pron.","meaning":"Ése, ésa, éso."},{"text":"-si","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'dicen que'. Indica que el hablante no ha sido testigo de la acción o no está muy seguro de lo que dice. Se usa cuando hay duda.  Cuando la palabra termina en vocal se usa la \"s\" y cuando termina en consonante se usa la \"si\" . El hablante declara o comenta sobre algo que escapa  de su conocimiento personal y directo (inconsciente)."}]},{"word":"ayllupi","morphemes":[{"text":"ayllu","type":"root","gloss":"s.","meaning":"Parentela"},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."}]},{"word":"tiyaq","morphemes":[{"text":"tiyaq","type":"root","gloss":"adj. y s.","meaning":"Que permanece sentado"}]},{"word":"runakuna","morphemes":[{"text":"runa","type":"root","gloss":"s.","meaning":"Gente, hombre, persona humana"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."}]},{"word":"sinchita","morphemes":[{"text":"sinchi","type":"root","gloss":"s.","meaning":"Jefe de las agru paciones militares en el inkario"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"llakikunku,","morphemes":[{"text":"llakiku","type":"root","gloss":"s.","meaning":"Penar, sufrir, afligirse, desconsolarse, entristecerse. "},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"uywankunapis","morphemes":[{"text":"uywankunapis","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"tulluyanku","morphemes":[{"text":"tulluya","type":"root","gloss":"v.","meaning":"Enflaquecer, adelgazar de cuerpo. "},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"mana","morphemes":[{"text":"mana","type":"root","gloss":"adv.","meaning":"Partícula de negación (no)."}]},{"word":"q'achu","morphemes":[{"text":"q'achu","type":"root","gloss":"s.","meaning":"Pasto, hierba alimenticia para el ganado y los conejos de indias o qowe. . "}]},{"word":"wiñaqtin,","morphemes":[{"text":"wiñaqti","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"hinaspa","morphemes":[{"text":"hina","type":"root","gloss":"v.","meaning":"Hacer u obrar de esta manera, de este modo; hacer así (ilustrando con mímica). "},{"text":"-spa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Indica que la acción dependiente es anterior a la del verbo principal. Puede ser un gerundio."}]},{"word":"unupis","morphemes":[{"text":"unu","type":"root","gloss":"s.","meaning":"Agua; líquido incoloro, inodoro e insípido compuesto por dos volúmenes de hidrógeno y uno de oxígeno. . "},{"text":"-pis","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Aditivo. Se traduce como ‘también’ o ‘incluso’. Coordina oraciones."}]},{"word":"ch'akirqapun","morphemes":[{"text":"ch'akirqapun","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"chayrayku","morphemes":[{"text":"chay","type":"root","gloss":"pron.","meaning":"Ése, ésa, éso."},{"text":"-yku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona plural excluyente."}]},{"word":"chakrakunapis","morphemes":[{"text":"chakra","type":"root","gloss":"s.","meaning":"Terreno cultivado. Sementera. Chacra. "},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."},{"text":"-pis","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Aditivo. Se traduce como ‘también’ o ‘incluso’. Coordina oraciones."}]},{"word":"mana","morphemes":[{"text":"mana","type":"root","gloss":"adv.","meaning":"Partícula de negación (no)."}]},{"word":"urinchu.","morpheme