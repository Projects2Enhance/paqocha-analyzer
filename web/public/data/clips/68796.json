mes":[{"text":"wata","type":"root","gloss":"s.","meaning":"calend. Año. Lapso de 365 días y 05 horas, en que la Tierra completa una vuelta alrededor del Sol. "}]},{"word":"chaypi","morphemes":[{"text":"chay","type":"root","gloss":"pron.","meaning":"Ése, ésa, éso."},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."}]},{"word":"kashayku.","morphemes":[{"text":"kasha","type":"root","gloss":"v.","meaning":"Estar. "},{"text":"-yku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona plural excluyente."}]}]}}