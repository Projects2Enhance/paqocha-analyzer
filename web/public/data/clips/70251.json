","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"ña","morphemes":[{"text":"ña","type":"root","gloss":"adv.","meaning":"Ya (partícula aspectual)."}]},{"word":"ruwarqushaniña,","morphemes":[{"text":"ruwarqushaniña","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"manaña","morphemes":[{"text":"mana","type":"root","gloss":"adv.","meaning":"Partícula de negación (no)."},{"text":"-ña","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a la palabra ‘ya’. Expresa que no se debe continuar."}]},{"word":"ashwanta","morphemes":[{"text":"ashwan","type":"root","gloss":"adv.","meaning":"Más, antes bien (variante Puno)."},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"qhipachisaqñachu,","morphemes":[{"text":"qhipachisaqña","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-chu","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Interrogativo que exige respuesta afirmativa o negativa. Solo para preguntas cerradas."}]},{"word":"kunan","morphemes":[{"text":"kuna","type":"root","gloss":"v.","meaning":"Aconsejar, advertir, recomendar"},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"p'unchay","morphemes":[{"text":"p'unchay","type":"root","gloss":"s.","meaning":"Día, tiempo que dura desde el amanecer hasta el anochecer. . E- . . . "}]},{"word":"tukurusaq.","morphemes":[{"text":"tukuru","type":"root","gloss":"s.","meaning":"Engrudo, mazamorra de harina usada como adhesivo. "},{"text":"-saq","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona singular."}]}]}}