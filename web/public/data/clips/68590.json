nto."}]},{"word":"qallarinku.","morphemes":[{"text":"qallari","type":"root","gloss":"v.","meaning":"Comenzar, empezar, iniciar o principiar un acto. . Pe.S. . "},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"Aylluypiqa","morphemes":[{"text":"ayllu","type":"root","gloss":"s.","meaning":"Parentela"},{"text":"-y","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo de primera persona singular."},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"wakin","morphemes":[{"text":"waki","type":"root","gloss":"s.","meaning":"Pareja que se asocia para formar una compañía o sociedad para trabajo agrícola"},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"runakuna","morphemes":[{"text":"runa","type":"root","gloss":"s.","meaning":"Gente, hombre, persona humana"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."}]},{"word":"uywankunallamanta","morphemes":[{"text":"uywankunallamanta","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"kawsakunku.","morphemes":[{"text":"kawsa","type":"root","gloss":"s.","meaning":"Vida"},{"text":"-ku","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica un verbo reflexivo. Funciona como los pronombres enclíticos: me, te, se, nos. Se convierte en ‘KA’, cuando precede al sufijo -MU. Con verbos transitivos. indica una acción refleja, o sea la acción recae  sobre el propio sujeto. En otros casos  indica beneficio o provecho personal. tambien tiene valor impersonal."},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"Imananqakutaq","morphemes":[{"text":"imana","type":"root","gloss":"v.","meaning":"Obrar como sea"},{"text":"-nqa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona singular."},{"text":"-ku","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica un verbo reflexivo. Funciona como los pronombres enclíticos: me, te, se, nos. Se convierte en ‘KA’, cuando precede al sufijo -MU. Con verbos transitivos. indica una acción refleja, o sea la acción recae  sobre el propio sujeto. En otros casos  indica beneficio o provecho personal. tambien tiene valor impersonal."},{"text":"-taq","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"También marca la pregunta abierta que requiere alguna información adicional como respuesta."}]},{"word":"paykuna","morphemes":[{"text":"pay","type":"root","gloss":"pron.","meaning":"Pronombre 3SG (él/ella)."},{"text":"-na","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."}]},{"word":"uywankuna","morphemes":[{"text":"uywankuna","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"wañuqtin?","morphemes":[{"text":"wañuqti","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]}]}}