emes":[{"text":"kachayu","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-wa","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -wa"},{"text":"-q","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Su marca es “-q” cuando termina en vocal y \"-paq\" cuando termina en consonante, que es igual a la preposición “de”."}]},{"word":"kanku","morphemes":[{"text":"ka","type":"root","gloss":"s.","meaning":"Acto de dar o entregar algo a otra persona. . "},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"uywa","morphemes":[{"text":"uywa","type":"root","gloss":"s.","meaning":"Animal, nombre genérico con que se conoce a los equinos"}]},{"word":"michiyllamanpuni,","morphemes":[{"text":"michiy","type":"root","gloss":"v.","meaning":"Pastorear el ganado en los pastizales. . Michos"},{"text":"-lla","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'solamente’ o ‘únicamente’.Transmite afecto o es atenuador en las órdenes."},{"text":"-man","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Es el sufijo que marca movimiento, direccionalidad, objeto indirecto, locación temporal y locación espacial. Indica movimiento con la preposición ‘a’, ‘hacia’."},{"text":"-puni","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Indica afirmación o negación rotunda; certidumbre plena ('definitivamente'). Expresa seguridad."}]},{"word":"chaymi","morphemes":[{"text":"chay","type":"root","gloss":"s.","meaning":"Descanso breve de medio día"},{"text":"-mi","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Validador. Indica que el hablante ha sido testigo de la acción o está muy seguro de lo que dice. No se debe de usar cuando hay duda.  Cuando la palabra termina en vocal se usa la \"m\" y cuando termina en consonante se usa la \"mi\". Hace referencia a una información directa en relación con lo enunciado por el hablante. Es para afirmar, declarar, sostener."}]},{"word":"yaqapis","morphemes":[{"text":"ya","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."},{"text":"-pis","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Aditivo. Se traduce como ‘también’ o ‘incluso’. Coordina oraciones."}]},{"word":"hunt'aran","morphemes":[{"text":"hunt'a","type":"root","gloss":"adj.","meaning":"Colmado, lleno, re pleto. . hunt'a"},{"text":"-ran","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -ran"}]},{"word":"llipin","morphemes":[{"text":"lli","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"p'unchayniyta,","morphemes":[{"text":"p'unchay","type":"root","gloss":"s.","meaning":"V. INTIU CHAY"},{"text":"-ni","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo que se agrega cuando la palabra termina en vocal, se sgrega antes del sufijo posesivo."},{"text":"-y","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo de primera persona singular."},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"awisninqa","morphemes":[{"text":"awisninqa","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"huq","morphemes":[{"text":"huq","type":"root","gloss":"adj. / pron.","meaning":"Uno, un, otro (variante fonética Collao)."}]},{"word":"ruwaykunawan","morphemes":[{"text":"ruway","type":"root","gloss":"v.","meaning":"V. LLANK'AY, RURAY"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."},{"text":"-wan","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Conjunción que enlaza palabras o frases ('y', 'con'). Es un caso cogitativo, porque indica compromiso, compañía o instrumento."}]},{"word":"yanapaq","morphemes":[{"text":"yanapaq","type":"root","gloss":"s.","meaning":"NEOL. Especialista, perito nom brado por el Juez como auxiliar de justicia. chaninchana wasipi"}]},{"word":"kani,","morphemes":[{"text":"kani","type":"root","gloss":"s.","meaning":"Mordedura"}]},{"word":"awina","morphemes":[{"text":"awi","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-na","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."}]},{"word":"rutuyta,","morphemes":[{"text":"rutuy","type":"root","gloss":"s.","meaning":"Corte de pelo. Ceremonia familiar del corte de la primera cabellera de las cria turas. . chukcha"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"papa","morphemes":[{"text":"papa","type":"root","gloss":"s.","meaning":"(Solanum lig nicauleVargas). Solanácea sil vestre. Una variedad de papa silvestre y comestible. . . "}]},{"word":"hasp'iyta,","morphemes":[{"text":"hasp'iy","type":"root","gloss":"v.","meaning":"Escarbar la tierra con cualquier motivo. "},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"kinuwa","morphemes":[{"text":"kinuwa","type":"root","gloss":"s.","meaning":"V. KIWINA"}]},{"word":"waqtayta","morphemes":[{"text":"waqtay","type":"root","gloss":"v.","meaning":"Azotar, latiguear, chi cotear, golpear con cuerda. "},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"ima.","morphemes":[{"text":"ima","type":"root","gloss":"pron. / adv.","meaning":"¿Qué?, qué, algo."}]}]}}