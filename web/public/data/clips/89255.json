VO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."},{"text":"-puni","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Indica afirmación o negación rotunda; certidumbre plena ('definitivamente'). Expresa seguridad."}]},{"word":"kay","morphemes":[{"text":"kay","type":"root","gloss":"pron.","meaning":"Este, esto, esta."}]},{"word":"llaqtakunapi","morphemes":[{"text":"llaqta","type":"root","gloss":"s.","meaning":"Ciudad, pueblo, comunidad, villorrio, comarca"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."}]},{"word":"llaqtaypipas,","morphemes":[{"text":"llaqta","type":"root","gloss":"s.","meaning":"Ciudad, pueblo, comunidad, villorrio, comarca"},{"text":"-y","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo de primera persona singular."},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."},{"text":"-pas","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Aditivo. Se traduce como ‘también’ o ‘incluso’. Coordina oraciones."}]},{"word":"suwakuna","morphemes":[{"text":"suwa","type":"root","gloss":"s.","meaning":"Saludo en la épo- ca inkaica. Contiene toda la filosofía de la vida del Imperio del Tawantinsuyu. Su traducción . En Wanka, Qosqo, se dice aú"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."}]},{"word":"nishuta","morphemes":[{"text":"nishu","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"purishanku","morphemes":[{"text":"puri","type":"root","gloss":"s.","meaning":"Locomoción, tracción o desplazamiento"},{"text":"-sha","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica una acción en proceso, que se prolonga en el tiempoo que está sucediendo ahora mismo."},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"chaykunan","morphemes":[{"text":"chay","type":"root","gloss":"pron.","meaning":"Ése, ésa, éso."},{"text":"-na","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"llakichikun","morphemes":[{"text":"llakichi","type":"root","gloss":"v.","meaning":"Apenar, afligir, causar pena, tristeza, sufrimiento. "},{"text":"-ku","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica un verbo reflexivo. Funciona como los pronombres enclíticos: me, te, se, nos. Se convierte en ‘KA’, cuando precede al sufijo -MU. Con verbos transitivos. indica una acción refleja, o sea la acción recae  sobre el propio sujeto. En otros casos  indica beneficio o provecho personal. tambien tiene valor impersonal."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"awiceq","morphemes":[{"text":"awice","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-q","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Su marca es “-q” cuando termina en vocal y \"-paq\" cuando termina en consonante, que es igual a la preposición “de”."}]},{"word":"chay","morphemes":[{"text":"chay","type":"root","gloss":"pron.","meaning":"Ése, ésa, éso."}]},{"word":"runakunaqa","morphemes":[{"text":"runa","type":"root","gloss":"s.","meaning":"Gente, hombre, persona humana"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning