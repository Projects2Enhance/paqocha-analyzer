matical","meaning":"Sufijo morfológico -wa"},{"text":"-nchis","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona plural incluyente."}]},{"word":"llipinchista,","morphemes":[{"text":"lli","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."},{"text":"-nchis","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona plural incluyente."},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"ichaqa","morphemes":[{"text":"icha","type":"root","gloss":"conj.","meaning":"O, quizás, tal vez."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"llipinchis","morphemes":[{"text":"lli","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."},{"text":"-nchis","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona plural incluyente."}]},{"word":"munasqan","morphemes":[{"text":"muna","type":"root","gloss":"s.","meaning":"Afición, inclinación, deseo, voluntad"},{"text":"-sqa","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Participio pasivo ('escrito') o pasado narrativo. indica hecho consumado, se utiliza en narraciones."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"kanchis,","morphemes":[{"text":"ka","type":"root","gloss":"s.","meaning":"Acto de dar o entregar algo a otra persona. . "},{"text":"-nchis","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona plural incluyente."}]},{"word":"mana","morphemes":[{"text":"mana","type":"root","gloss":"adv.","meaning":"Partícula de negación (no)."}]},{"word":"payqa","morphemes":[{"text":"pay","type":"root","gloss":"pron.","meaning":"Pronombre 3SG (él/ella)."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"huqkunallatachu","morphemes":[{"text":"huq","type":"root","gloss":"adj. / pron.","meaning":"Uno, un, otro (variante fonética Collao)."},{"text":"-na","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."},{"text":"-lla","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'solamente’ o ‘únicamente’.Transmite afecto o es atenuador en las órdenes."},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."},{"text":"-chu","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Interrogativo que exige respuesta afirmativa o negativa. Solo para preguntas cerradas."}]},{"word":"munan.","morphemes":[{"text":"muna","type":"root","gloss":"s.","meaning":"Afición, inclinación, deseo, voluntad"},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]}]}}