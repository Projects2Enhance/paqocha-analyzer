hemes":[{"text":"kay","type":"root","gloss":"pron.","meaning":"Este, esto, esta."},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."}]},{"word":"nuqaq","morphemes":[{"text":"nuqa","type":"root","gloss":"pron.","meaning":"Pronombre 1SG (yo). Variante regional Collao/Puno."},{"text":"-q","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Su marca es “-q” cuando termina en vocal y \"-paq\" cuando termina en consonante, que es igual a la preposición “de”."}]},{"word":"ruwayniykama","morphemes":[{"text":"ruway","type":"root","gloss":"v.","meaning":"V. LLANK'AY, RURAY"},{"text":"-ni","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo que se agrega cuando la palabra termina en vocal, se sgrega antes del sufijo posesivo."},{"text":"-y","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo de primera persona singular."},{"text":"-kama","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica límite ('hasta') o simultaneidad ('mientras', 'mientras tanto', 'entre tanto', 'en tanto'). El otro valor dekama es el distributivo (cada quien, entre)."}]},{"word":"karan.","morphemes":[{"text":"ka","type":"root","gloss":"s.","meaning":"Acto de dar o entregar algo a otra persona. . "},{"text":"-ran","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -ran"}]}]}}