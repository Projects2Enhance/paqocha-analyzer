emes":[{"text":"icha","type":"root","gloss":"conj.","meaning":"O, quizás, tal vez."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"plasaq","morphemes":[{"text":"pla","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-saq","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de primera persona singular."}]},{"word":"qayllallanpi","morphemes":[{"text":"qaylla","type":"root","gloss":"s.","meaning":"Presencia, asistencia, orden. . . "},{"text":"-lla","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'solamente’ o ‘únicamente’.Transmite afecto o es atenuador en las órdenes."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."},{"text":"-pi","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica locación en  el  tiempo  y  en  el espacio. Corresponde a la preposición ‘en’."}]},{"word":"kashan,","morphemes":[{"text":"kasha","type":"root","gloss":"v.","meaning":"Estar. EJEM: Perú suyupin Qosqoqa kashan, el Qosqo está en el Perú."},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"imata","morphemes":[{"text":"ima","type":"root","gloss":"pron. / adv.","meaning":"¿Qué?, qué, algo."},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"rantikuyta","morphemes":[{"text":"rantikuy","type":"root","gloss":"v.","meaning":"Comprar algo ex clusivamente para sí"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"munani","morphemes":[{"text":"muna","type":"root","gloss":"s.","meaning":"Afición, inclinación, deseo, voluntad"},{"text":"-ni","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo que se agrega cuando la palabra termina en vocal, se sgrega antes del sufijo posesivo."}]},{"word":"hinapis","morphemes":[{"text":"hina","type":"root","gloss":"v.","meaning":"Hacer u obrar de esta manera, de este modo; hacer así (ilustrando con mímica). "},{"text":"-pis","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Aditivo. Se traduce como ‘también’ o ‘incluso’. Coordina oraciones."}]},{"word":"ratu","morphemes":[{"text":"ratu","type":"root","gloss":"desconocido","meaning":"—"}]},{"word":"phawarini","morphemes":[{"text":"phawari","type":"root","gloss":"v.","meaning":"Volar, correr, echar al vuelo, salir a la carrera"},{"text":"-ni","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo que se agrega cuando la palabra termina en vocal, se sgrega antes del sufijo posesivo."}]},{"word":"mashkhariq.","morphemes":[{"text":"mashkha","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-ri","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Expresa el inicio del proceso verbal o la realización parcial de aquél. Indica también matiz de cortesía sobre pedidos o mandatos. Indica el inicio de una acción."},{"text":"-q","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Su marca es “-q” cuando termina en vocal y \"-paq\" cuando termina en consonante, que es igual a la preposición “de”."}]}]}}