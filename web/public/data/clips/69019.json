oot","gloss":"s.","meaning":"Ciudad metro- poli, gran ciudad"},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"ñawpa","morphemes":[{"text":"ñawpa","type":"root","gloss":"adj.","meaning":"Antiguo, remoto, pasado, anterior. . . ñawpa"}]},{"word":"ñawpa","morphemes":[{"text":"ñawpa","type":"root","gloss":"adj.","meaning":"Antiguo, remoto, pasado, anterior. . . ñawpa"}]},{"word":"pachan,","morphemes":[{"text":"pacha","type":"root","gloss":"s.","meaning":"Tiempo o época de la siega. . ichhuy"},{"text":"-n","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo posesivo  de tercera persona singular."}]},{"word":"paqarisqa","morphemes":[{"text":"paqari","type":"root","gloss":"s.","meaning":"y v. V. PACHAILLARIY, P'UNCHAY"},{"text":"-sqa","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Participio pasivo ('escrito') o pasado narrativo. indica hecho consumado, se utiliza en narraciones."}]},{"word":"Inka","morphemes":[{"text":"inka","type":"root","gloss":"s.","meaning":"Se utiliza despectivamente para indicar al concubino o amante ilícito de la mujer casa da. "}]},{"word":"pachamantapas","morphemes":[{"text":"pacha","type":"root","gloss":"s.","meaning":"Tiempo o época de la siega. . ichhuy"},{"text":"-manta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica procedencia (‘de’, ‘desde’) o el material de algo."},{"text":"-pas","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Aditivo. Se traduce como ‘también’ o ‘incluso’. Coordina oraciones."}]},{"word":"ñawpaqraq.","morphemes":[{"text":"ñawpaq","type":"root","gloss":"adj.","meaning":"y s. . "},{"text":"-raq","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Indica anterioridad o la continuidad de un estado de cosas."}]},{"word":"Chaymantataq","morphemes":[{"text":"chay","type":"root","gloss":"s.","meaning":"Descanso breve de medio día"},{"text":"-manta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Indica procedencia (‘de’, ‘desde’) o el material de algo."},{"text":"-taq","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"También marca la pregunta abierta que requiere alguna información adicional como respuesta."}]},{"word":"Ispañulkuna","morphemes":[{"text":"ispañul","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."}]},{"word":"chayamuspa","morphemes":[{"text":"chayamu","type":"root","gloss":"v.","meaning":"Dirigirse y llegar hasta aquí"},{"text":"-spa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Indica que la acción dependiente es anterior a la del verbo principal. Puede ser un gerundio."}]},{"word":"musuq","morphemes":[{"text":"musuq","type":"root","gloss":"adj.","meaning":"V. MOSOQ"}]},{"word":"llaqtata","morphemes":[{"text":"llaqta","type":"root","gloss":"s.","meaning":"Ciudad metro- poli, gran ciudad"},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"sayarichisqaku,","morphemes":[{"text":"sayarichi","type":"root","gloss":"v.","meaning":"Hacer que una persona se ponga de pie, que se levante"},{"text":"-sqa","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Participio pasivo ('escrito') o pasado narrativo. indica hecho consumado, se utiliza en narraciones."},{"text":"-ku","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica un verbo reflexivo. Funciona como los pronombres enclíticos: me, te, se, nos. Se convierte en ‘KA’, cuando precede al sufijo -MU. Con verbos transitivos. indica una acción refleja, o sea la acción recae  sobre el propio sujeto. En otros casos  indica beneficio o provecho personal. tambien tiene valor impersonal."}]},{"word":"ichaqa","morphemes":[{"text":"icha","type":"root","gloss":"conj.","meaning":"O, quizás, tal vez."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"kay","morphemes":[{"text":"kay","type":"root","gloss":"s.","meaning":"allin"}]},{"word":"hallp'aqa","morphemes":[{"text":"hallp'a","type":"root","gloss":"s.","meaning":"Limo. Terreno de cultivo. . . . . "},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"ñawpamantapachan","morphemes":[{"text":"ña","type":"root","gloss":"adv.","meaning":"Ya (partícula aspectual)."},{"text":"-wpamantapachan","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -wpamantapachan"}]},{"word":"runayuq","morphemes":[{"text":"runayu","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-q","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Su marca es “-q” cuando termina en vocal y \"-paq\" cuando termina en consonante, que es igual a la preposición “de”."}]},{"word":"karqan.","morphemes":[{"text":"ka","type":"root","gloss":"s.","meaning":"Acto de dar o entregar algo a otra persona. . "},{"text":"-rqan","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -rqan"}]}]}}