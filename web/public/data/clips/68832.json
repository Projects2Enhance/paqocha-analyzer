es":[{"text":"ñawpa","type":"root","gloss":"adj.","meaning":"Antiguo, remoto, pasado, anterior. . . ñawpa"}]},{"word":"runakunapaq","morphemes":[{"text":"runa","type":"root","gloss":"adj.","meaning":"V. RUNALLAÑA"},{"text":"-kuna","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Pluraliza los sustantivos."},{"text":"-paq","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Es el sufijo que indica al destinatario o beneficiario de una acción o de algo. Estos pueden ser destinatarios directos o indirectos. Indica la preposición ‘para’. Cuando le antecede una acción verbal se convierte en NAPAQ,"}]},{"word":"ancha","morphemes":[{"text":"ancha","type":"root","gloss":"adv.","meaning":"Muy, bastante, sumamente."}]},{"word":"chaniyuq","morphemes":[{"text":"chaniyuq","type":"root","gloss":"adj.","meaning":"Que tiene valor, pre cio. "}]},{"word":"mikhuymi","morphemes":[{"text":"mikhuy","type":"root","gloss":"v.","meaning":"Comer, alimentarse, yantar, ingerir alimentos. . . . "},{"text":"-mi","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Validador. Indica que el hablante ha sido testigo de la acción o está muy seguro de lo que dice. No se debe de usar cuando hay duda.  Cuando la palabra termina en vocal se usa la \"m\" y cuando termina en consonante se usa la \"mi\". Hace referencia a una información directa en relación con lo enunciado por el hablante. Es para afirmar, declarar, sostener."}]},{"word":"karqan.","morphemes":[{"text":"ka","type":"root","gloss":"s.","meaning":"Acto de dar o entregar algo a otra persona. . "},{"text":"-rqan","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -rqan"}]},{"word":"Ashkha","morphemes":[{"text":"ashkha","type":"root","gloss":"adj.","meaning":"Mucho, bastante (variante de askha)."}]},{"word":"chaywanlla","morphemes":[{"text":"chay","type":"root","gloss":"s.","meaning":"Descanso breve de medio día"},{"text":"-wan","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Conjunción que enlaza palabras o frases ('y', 'con'). Es un caso cogitativo, porque indica compromiso, compañía o instrumento."},{"text":"-lla","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'solamente’ o ‘únicamente’.Transmite afecto o es atenuador en las órdenes."}]},{"word":"kawsarqanku.","morphemes":[{"text":"kawsa","type":"root","gloss":"s.","meaning":"Vida"},{"text":"-rqa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Temporizador de pasado simple lejano y experimentado"},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]},{"word":"Paykunaqa","morphemes":[{"text":"pay","type":"root","gloss":"pron.","meaning":"Pronombre 3SG (él/ella)."},{"text":"-na","type":"suffix","gloss":"DERIVACIONAL DEVERBATIVO","meaning":"Convierte una raíz verbal en sustantivo. concretiza o sustantiviza a un verbo."},{"text":"-qa","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Denota información novedosa."}]},{"word":"tarpusqankuta,","morphemes":[{"text":"tarpusqa","type":"root","gloss":"adj.","meaning":"Sembrado. "},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"mikhuyninkuta","morphemes":[{"text":"mikhuy","type":"root","gloss":"v.","meaning":"Comer, alimentarse, yantar, ingerir alimentos. . . . "},{"text":"-ni","type":"suffix","gloss":"FLEXIVO DE PERSONA","meaning":"Sufijo que se agrega cuando la palabra termina en vocal, se sgrega antes del sufijo posesivo."},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."},{"text":"-ta","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Designa el objeto directo con los verbos que no son de movimiento."}]},{"word":"ima","morphemes":[{"text":"ima","type":"root","gloss":"pron. / adv.","meaning":"¿Qué?, qué, algo."}]},{"word":"waqaychaspa","morphemes":[{"text":"waqaycha","type":"root","gloss":"adj.","meaning":"Reserva, guarda, ahorro, previsión, caudal"},{"text":"-spa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Indica que la acción dependiente es anterior a la del verbo principal. Puede ser un gerundio."}]},{"word":"waqaychaqku.","morphemes":[{"text":"waqaychaq","type":"root","gloss":"s.","meaning":"NEOL. Notario Público. Funcionario público autorizado para dar fe, conforme a la ley de notariado"},{"text":"-ku","type":"suffix","gloss":"FLEXIVOS DERIVACIONALES","meaning":"Indica un verbo reflexivo. Funciona como los pronombres enclíticos: me, te, se, nos. Se convierte en ‘KA’, cuando precede al sufijo -MU. Con verbos transitivos. indica una acción refleja, o sea la acción recae  sobre el propio sujeto. En otros casos  indica beneficio o provecho personal. tambien tiene valor impersonal."}]},{"word":"Hinallataqmi","morphemes":[{"text":"hina","type":"root","gloss":"v.","meaning":"Hacer u obrar de esta manera, de este modo; hacer así (ilustrando con mímica). "},{"text":"-lla","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Corresponde a 'solamente’ o ‘únicamente’.Transmite afecto o es atenuador en las órdenes."},{"text":"-taq","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"También marca la pregunta abierta que requiere alguna información adicional como respuesta."},{"text":"-mi","type":"suffix","gloss":"SUFIJO INDEPENDIENTE","meaning":"Validador. Indica que el hablante ha sido testigo de la acción o está muy seguro de lo que dice. No se debe de usar cuando hay duda.  Cuando la palabra termina en vocal se usa la \"m\" y cuando termina en consonante se usa la \"mi\". Hace referencia a una información directa en relación con lo enunciado por el hablante. Es para afirmar, declarar, sostener."}]},{"word":"ñawpaqmantapacha","morphemes":[{"text":"ña","type":"root","gloss":"adv.","meaning":"Ya (partícula aspectual)."},{"text":"-wpaqmantapacha","type":"suffix","gloss":"Sufijo Gramatical","meaning":"Sufijo morfológico -wpaqmantapacha"}]},{"word":"truikiwan","morphemes":[{"text":"truiki","type":"root","gloss":"desconocido","meaning":"—"},{"text":"-wan","type":"suffix","gloss":"FLEXIVO DE CASO","meaning":"Conjunción que enlaza palabras o frases ('y', 'con'). Es un caso cogitativo, porque indica compromiso, compañía o instrumento."}]},{"word":"tiyarqanku.","morphemes":[{"text":"tiya","type":"root","gloss":"s.","meaning":"Brasero, braserillo, quemador usual, pebetero. (J.L.P.) tiya tiya. adv. Permanecer sentadas varias personas"},{"text":"-rqa","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Temporizador de pasado simple lejano y experimentado"},{"text":"-nku","type":"suffix","gloss":"FLEXIVO DE NUMERO","meaning":"Sufijo de tercera persona plural."}]}]}}